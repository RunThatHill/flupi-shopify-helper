<style>
  /* Navigation bar wrapper styling */
  .favo-mega-nav-wrapper {
    width: 100%;
    border-bottom: 1px solid #e5e5e5;
    background-color: var(--nav-bg-color, #ffffff);
    position: relative;
    z-index: 100;
    font-family: inherit;
  }

  .favo-mega-nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .favo-mega-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
    height: 52px;
  }

  /* Link item and hover animations */
  .favo-mega-nav-item {
    position: static; /* Dropdown spans 100% width of the wrapper block */
  }

  .favo-mega-nav-link {
    display: block;
    padding: 15px 0;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--nav-text-color, #121212);
    text-decoration: none;
    letter-spacing: 0.5px;
    position: relative;
    transition: opacity 0.25s ease;
  }

  /* Sibling hover fade effect (Pure CSS, 0ms lag) */
  .favo-mega-nav-list:hover .favo-mega-nav-link {
    opacity: 0.4;
  }

  .favo-mega-nav-item:hover .favo-mega-nav-link {
    opacity: 1.0;
  }

  /* Center-out active line underline animation */
  .favo-mega-nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--nav-text-color, #121212);
    transform: scaleX(0);
    transition: transform 0.25s ease-out;
  }

  .favo-mega-nav-item:hover .favo-mega-nav-link::after {
    transform: scaleX(1);
  }

  /* Mega menu dropdown container (transition-based fade & slide down) */
  .favo-mega-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: #ffffff;
    border-top: 1px solid #e5e5e5;
    border-bottom: 2px solid var(--nav-text-color, #121212);
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
    z-index: 99;
    pointer-events: none; /* Ignore hover actions when hidden */
  }

  .favo-mega-nav-item:hover .favo-mega-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto; /* Enable mouse hover actions inside visible dropdown */
  }

  /* Inner layouts split */
  .favo-mega-dropdown-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 30px 20px;
    display: grid;
    grid-template-columns: 2fr 1fr; /* 2 parts list columns, 1 part side promos */
    gap: 40px;
  }

  /* Category Columns lists */
  .favo-mega-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    text-align: left;
  }

  .favo-mega-column-title {
    margin: 0 0 12px 0;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .favo-mega-column-title a {
    text-decoration: none;
    color: #121212;
  }

  .favo-mega-column-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .favo-mega-column-list li {
    margin-bottom: 8px;
  }

  .favo-mega-column-link {
    text-decoration: none;
    color: #707070;
    font-size: 13px;
    transition: color 0.2s ease;
  }

  .favo-mega-column-link:hover {
    color: #121212;
  }

  /* Sidebar Banners (Promos) */
  .favo-mega-promos {
    display: flex;
    gap: 20px;
  }

  .favo-mega-promo-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #121212;
    transition: opacity 0.2s ease;
  }

  .favo-mega-promo-card:hover {
    opacity: 0.95;
  }

  .favo-promo-img-wrapper {
    position: relative;
    padding-top: 100%; /* square ratio matching OUTNET layout */
    overflow: hidden;
    background-color: #f5f5f5;
    margin-bottom: 12px;
  }

  .favo-promo-img-wrapper img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .favo-mega-promo-card:hover img {
    transform: scale(1.04);
  }

  .favo-promo-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 0.5px;
  }

  .favo-mega-column-error {
    color: #ef4444;
    font-size: 13px;
    padding: 10px;
    background: #fef2f2;
    border: 1px dashed #fca5a5;
  }
</style>

<div class="favo-mega-nav-wrapper" 
     style="--nav-bg-color: {{ section.settings.background_color | default: '#ffffff' }}; --nav-text-color: {{ section.settings.text_color | default: '#121212' }};">
  <nav class="favo-mega-nav" aria-label="Mega Navigation">
    <ul class="favo-mega-nav-list">
      
      <!-- Load custom menu items from shop metaobject values sorted by position -->
      {% assign sorted_items = shop.metaobjects.mega_menu_item.values | sort: "position" %}
      {% for item in sorted_items %}
        {% assign menu_handle = item.menu_handle.value | default: item.menu_handle %}
        <li class="favo-mega-nav-item">
          <a href="{{ item.url.value | default: item.url | default: '#' }}" class="favo-mega-nav-link">
            {{ item.title.value | default: item.title | escape }}
          </a>
          
          <!-- Dropdown container if navigation list or promos are attached -->
          {% if menu_handle != blank or item.promo_image_1 != blank or item.promo_image_2 != blank %}
            <div class="favo-mega-dropdown">
              <div class="favo-mega-dropdown-inner">
                
                <!-- Category columns -->
                {% if menu_handle != blank %}
                  <div class="favo-mega-columns">
                    {% assign submenu = linklists[menu_handle] %}
                    {% if submenu != blank and submenu.links.size > 0 %}
                      {% for link in submenu.links %}
                        <div class="favo-mega-column">
                          <h5 class="favo-mega-column-title">
                            <a href="{{ link.url }}">{{ link.title }}</a>
                          </h5>
                          {% if link.links != blank %}
                            <ul class="favo-mega-column-list">
                              {% for child_link in link.links %}
                                <li>
                                  <a href="{{ child_link.url }}" class="favo-mega-column-link">
                                    {{ child_link.title }}
                                  </a>
                                </li>
                              {% endfor %}
                            </ul>
                          {% endif %}
                        </div>
                      {% endfor %}
                    {% else %}
                      <div class="favo-mega-column-error">
                        Menu handle '<strong>{{ menu_handle }}</strong>' could not be resolved. Please create it under <em>Online Store > Navigation</em>.
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
                
                <!-- Side promotional cards -->
                <div class="favo-mega-promos">
                  {% if item.promo_image_1 != blank %}
                    {% assign p_img_1 = item.promo_image_1.value | default: item.promo_image_1 %}
                    <a href="{{ item.promo_url_1.value | default: item.promo_url_1 | default: '#' }}" class="favo-mega-promo-card">
                      <div class="favo-promo-img-wrapper">
                        <img src="{{ p_img_1 | image_url: width: 400 }}" alt="{{ item.promo_title_1.value | default: item.promo_title_1 | escape }}" loading="lazy" width="400" height="400" />
                      </div>
                      <span class="favo-promo-title">{{ item.promo_title_1.value | default: item.promo_title_1 }}</span>
                    </a>
                  {% endif %}
                  
                  {% if item.promo_image_2 != blank %}
                    {% assign p_img_2 = item.promo_image_2.value | default: item.promo_image_2 %}
                    <a href="{{ item.promo_url_2.value | default: item.promo_url_2 | default: '#' }}" class="favo-mega-promo-card">
                      <div class="favo-promo-img-wrapper">
                        <img src="{{ p_img_2 | image_url: width: 400 }}" alt="{{ item.promo_title_2.value | default: item.promo_title_2 | escape }}" loading="lazy" width="400" height="400" />
                      </div>
                      <span class="favo-promo-title">{{ item.promo_title_2.value | default: item.promo_title_2 }}</span>
                    </a>
                  {% endif %}
                </div>
                
              </div>
            </div>
          {% endif %}
          
        </li>
      {% endfor %}
      
    </ul>
  </nav>
</div>

{% schema %}
{
  "name": "Favo Mega Navigation",
  "target": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#121212"
    }
  ]
}
{% endschema %}
