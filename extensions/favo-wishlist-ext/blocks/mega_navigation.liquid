<style>
  /* Override Shopify app block wrapper position */
  .shopify-block,
  .shopify-app-block {
    position: static !important;
  }

  /* Navigation bar wrapper styling */
  .favo-mega-nav-wrapper {
    width: 100%;
    border-bottom: 1px solid #e5e5e5;
    background-color: var(--nav-bg-color, #ffffff);
    position: relative;
    z-index: 100;
    font-family: inherit;
  }

  .favo-mega-nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: static !important;
  }

  .favo-mega-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
    height: 52px;
    position: static !important;
  }

  /* Link item and hover animations */
  .favo-mega-nav-item {
    position: static !important; /* Forced static so absolute children stretch to full-width wrapper */
  }

  .favo-mega-nav-link {
    display: block;
    padding: 15px 0;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--nav-text-color, #121212);
    text-decoration: none;
    letter-spacing: 0.5px;
    position: relative;
    transition: opacity 0.25s ease;
  }

  /* Sibling hover fade effect (Pure CSS, 0ms lag) */
  .favo-mega-nav-list:hover .favo-mega-nav-link {
    opacity: 0.4;
  }

  .favo-mega-nav-item:hover .favo-mega-nav-link {
    opacity: 1.0;
  }

  /* Center-out active line underline animation */
  .favo-mega-nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--nav-text-color, #121212);
    transform: scaleX(0);
    transition: transform 0.25s ease-out;
  }

  .favo-mega-nav-item:hover .favo-mega-nav-link::after {
    transform: scaleX(1);
  }

  /* Mega menu dropdown container (transition-based fade & slide down) */
  .favo-mega-dropdown {
    position: absolute !important;
    top: 100% !important;
    left: 0 !important;
    width: 100% !important;
    box-sizing: border-box !important;
    background-color: #ffffff !important;
    border-top: 1px solid #e5e5e5 !important;
    border-bottom: 2px solid var(--nav-text-color, #121212) !important;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08) !important;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
    z-index: 99999 !important; /* Forced layout layering on top of heroes */
    pointer-events: none; /* Ignore hover actions when hidden */
  }

  .favo-mega-nav-item:hover .favo-mega-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto; /* Enable mouse hover actions inside visible dropdown */
  }

  /* Inner layouts split */
  .favo-mega-dropdown-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 35px 20px;
    display: grid;
    grid-template-columns: 2fr 1.2fr; /* 2 parts list columns, 1.2 parts side promos */
    gap: 40px;
    box-sizing: border-box;
  }

  /* Category Columns lists */
  .favo-mega-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    text-align: left;
  }

  .favo-mega-column-title {
    margin: 0 0 12px 0;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .favo-mega-column-title a {
    text-decoration: none;
    color: #121212;
  }

  .favo-mega-column-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .favo-mega-column-list li {
    margin-bottom: 8px;
  }

  .favo-mega-column-link {
    text-decoration: none;
    color: #707070;
    font-size: 13px;
    transition: color 0.2s ease;
  }

  .favo-mega-column-link:hover {
    color: #121212;
  }

  /* Sidebar Banners (Promos) */
  .favo-mega-promos {
    display: flex;
    gap: 24px;
    justify-content: flex-end;
  }

  .favo-mega-promo-card {
    flex: 1;
    min-width: 160px;
    max-width: 240px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #121212;
    transition: opacity 0.2s ease;
  }

  .favo-mega-promo-card:hover {
    opacity: 0.95;
  }

  .favo-promo-img-wrapper {
    position: relative;
    padding-top: 100%; /* square ratio matching OUTNET layout */
    overflow: hidden;
    background-color: #f5f5f5;
    margin-bottom: 12px;
  }

  .favo-promo-img-wrapper img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .favo-promo-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f1f5f9;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 500;
  }

  .favo-mega-promo-card:hover img {
    transform: scale(1.04);
  }

  .favo-promo-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 0.5px;
    margin-top: 4px;
  }

  .favo-nav-empty {
    padding: 20px;
    text-align: center;
    font-size: 14px;
    color: #707070;
    border: 1px dashed #e5e5e5;
  }
</style>

{% assign main_menu = linklists[block.settings.menu] %}

{% if main_menu != blank %}
  <div class="favo-mega-nav-wrapper" 
       style="--nav-bg-color: {{ block.settings.background_color | default: '#ffffff' }}; --nav-text-color: {{ block.settings.text_color | default: '#121212' }};">
    <nav class="favo-mega-nav" aria-label="Mega Navigation">
      <ul class="favo-mega-nav-list">
        
        {% for link in main_menu.links %}
          <li class="favo-mega-nav-item">
            <a href="{{ link.url }}" class="favo-mega-nav-link">
              {{ link.title }}
            </a>
            
            <!-- Generate dropdown if submenu contains active links -->
            {% if link.links != blank %}
              <div class="favo-mega-dropdown">
                <div class="favo-mega-dropdown-inner">
                  
                  <!-- Subcategory column list (Level 2 & Level 3 Links) -->
                  <div class="favo-mega-columns">
                    {% for child_link in link.links %}
                      {% assign lowercase_title = child_link.title | downcase %}
                      
                      <!-- If title doesn't start with 'promo:', render it as a standard text column -->
                      {% unless lowercase_title contains 'promo:' %}
                        <div class="favo-mega-column">
                          <h5 class="favo-mega-column-title">
                            <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                          </h5>
                          {% if child_link.links != blank %}
                            <ul class="favo-mega-column-list">
                              {% for grandchild_link in child_link.links %}
                                <li>
                                  <a href="{{ grandchild_link.url }}" class="favo-mega-column-link">
                                    {{ grandchild_link.title }}
                                  </a>
                                </li>
                              {% endfor %}
                            </ul>
                          {% endif %}
                        </div>
                      {% endunless %}
                    {% endfor %}
                  </div>
                  
                  <!-- Promotional image banners (Level 2 Links prefixed with 'PROMO:') -->
                  <div class="favo-mega-promos">
                    {% for child_link in link.links %}
                      {% assign lowercase_title = child_link.title | downcase %}
                      
                      {% if lowercase_title contains 'promo:' %}
                        <!-- Clean title by stripping 'PROMO:' prefix -->
                        {% assign promo_title = child_link.title | split: ":" | last | strip %}
                        
                        <!-- Retrieve featured image automatically from the linked Collection or Product -->
                        {% assign promo_image = '' %}
                        {% if child_link.type == 'collection_link' and child_link.object.image != blank %}
                          {% assign promo_image = child_link.object.image %}
                        {% elsif child_link.type == 'product_link' and child_link.object.featured_image != blank %}
                          {% assign promo_image = child_link.object.featured_image %}
                        {% endif %}
                        
                        <a href="{{ child_link.url }}" class="favo-mega-promo-card">
                          <div class="favo-promo-img-wrapper">
                            {% if promo_image != blank %}
                              <img src="{{ promo_image | image_url: width: 400 }}" alt="{{ promo_title | escape }}" loading="lazy" width="400" height="400" />
                            {% else %}
                              <div class="favo-promo-placeholder">No Image</div>
                            {% endif %}
                          </div>
                          <span class="favo-promo-title">{{ promo_title }}</span>
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                  
                </div>
              </div>
            {% endif %}
            
          </li>
        {% endfor %}
        
      </ul>
    </nav>
  </div>
{% else %}
  <div class="favo-mega-nav-wrapper favo-nav-empty">
    <p>Please select a navigation menu in the customization settings to display the Mega Menu.</p>
  </div>
{% endif %}

{% schema %}
{
  "name": "Favo Mega Navigation",
  "target": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Select Mega Menu List"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#121212"
    }
  ]
}
{% endschema %}
