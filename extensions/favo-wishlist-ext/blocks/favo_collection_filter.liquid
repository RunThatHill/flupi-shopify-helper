{{ 'favo_collection_filter.css' | asset_url | stylesheet_tag }}

<div class="favo-filter-sidebar" id="favo-collection-filter-root" data-collection-handle="{{ collection.handle }}">
  <div class="favo-filter-header">
    <div style="display: flex; align-items: center; gap: 10px;">
      <button type="button" class="favo-filter-close-btn" id="favo-filter-close-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256">
          <path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"></path>
        </svg>
      </button>
      <span>Filters</span>
    </div>
    <button type="button" class="favo-filter-clear-btn" id="favo-filter-clear-all">Clear All</button>
  </div>

  <div class="favo-filter-accordion-container" id="favo-filter-accordions">
    <!-- Filters are loaded dynamically via JS -->
  </div>

  <div class="favo-filter-mobile-footer">
    <button type="button" class="favo-filter-apply-btn" id="favo-filter-apply-btn">See Results</button>
  </div>
</div>

<script src="{{ "favo_collection_filter.js" | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Favo Collection Filter",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Filters"
    }
  ]
}
{% endschema %}
