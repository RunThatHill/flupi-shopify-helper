          <span>Privacy Settings</span>
        </div>
        <p class="favo-card-desc">View and manage your privacy settings</p>
      </a>
    </div>

    <a href="/account/logout" class="favo-account-signout">Sign Out</a>
  </div>

  <!-- SPA Split Panel View -->
  <div id="favo-view-split" class="favo-account-split favo-filter-hidden">
    <aside class="favo-account-sidebar">
      <ul class="favo-sidebar-list">
        <li><a href="#" class="favo-sidebar-link">Your Account</a></li>
        <li><a href="#my-orders" class="favo-sidebar-link" data-target="my-orders">My Orders</a></li>
        <li><a href="/pages/wishlist" class="favo-sidebar-link">Wish List</a></li>
        <li><a href="#account-details" class="favo-sidebar-link" data-target="account-details">Account Details</a></li>
        <li><a href="#address-book" class="favo-sidebar-link" data-target="address-book">Address Book</a></li>
        <li><a href="#store-credit" class="favo-sidebar-link" data-target="store-credit">Store Credit</a></li>
        <li><a href="#payment-methods" class="favo-sidebar-link" data-target="payment-methods">Payment Methods</a></li>
        <li><a href="#marketing" class="favo-sidebar-link" data-target="marketing">Marketing Preferences</a></li>
        <li><a href="#privacy" class="favo-sidebar-link" data-target="privacy">Privacy Settings</a></li>
        <li class="favo-sidebar-signout"><a href="/account/logout" class="favo-sidebar-link">Sign Out</a></li>
      </ul>
    </aside>

    <main class="favo-account-content">
      
      <!-- Panel: My Orders -->
      <section id="panel-my-orders" class="favo-panel-section">
        <h3 class="favo-panel-title">My Orders</h3>
        <p class="favo-panel-subtitle">Track your order or create a return</p>
        <hr class="favo-panel-divider">
        
        {% if customer.orders.size > 0 %}
          <table class="favo-orders-table">
            <thead>
              <tr>
                <th>Order</th>
                <th>Date</th>
                <th>Payment</th>
                <th>Fulfillment</th>
                <th>Total</th>
              </tr>
            </thead>
            <tbody>
              {% for order in customer.orders %}
                <tr>
                  <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_net_amount | money }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <div class="favo-empty-state">
            <p>You haven't placed any orders yet.</p>
            <a href="/collections/all" class="favo-btn-black">Start Shopping</a>
          </div>
        {% endif %}
      </section>

      <!-- Panel: Account Details -->
      <section id="panel-account-details" class="favo-panel-section">
        <h3 class="favo-panel-title">Account Details</h3>
        <p class="favo-panel-subtitle">Change your sign in information</p>
        <hr class="favo-panel-divider">
        
        <div style="margin-bottom: 24px;">
          <p style="margin-bottom: 8px;"><strong>Full Name:</strong> {{ customer.name }}</p>
          <p style="margin-bottom: 8px;"><strong>Email Address:</strong> {{ customer.email }}</p>
          {% if customer.phone != blank %}
            <p style="margin-bottom: 8px;"><strong>Phone:</strong> {{ customer.phone }}</p>
          {% endif %}
        </div>
        
        <a href="https://account.flupi.store/profile" class="favo-btn-black">Edit Details</a>
      </section>

      <!-- Panel: Address Book -->
      <section id="panel-address-book" class="favo-panel-section">
        <h3 class="favo-panel-title">Address Book</h3>
        <p class="favo-panel-subtitle">Manage your addresses</p>
        <hr class="favo-panel-divider">
        
        {% if customer.addresses_count > 0 %}
          <div class="favo-address-grid">
            {% for address in customer.addresses %}
              <div class="favo-address-card {% if address == customer.default_address %}default-address{% endif %}">
                <h4>
                  {{ address.first_name }} {{ address.last_name }}
                  {% if address == customer.default_address %}
                    <span style="font-size: 11px; font-weight: normal; color: #707070; margin-left: 5px;">(Default)</span>
                  {% endif %}
                </h4>
                <p>
                  {{ address.address1 }}<br>
                  {% if address.address2 != blank %}{{ address.address2 }}<br>{% endif %}
                  {{ address.city }}, {{ address.province_code }} {{ address.zip }}<br>
                  {{ address.country }}
                </p>
              </div>
            {% endfor %}
          </div>
          <br>
        {% endif %}
        
        <a href="https://account.flupi.store/profile" class="favo-btn-black">Manage Addresses</a>
      </section>

      <!-- Panel: Store Credit -->
      <section id="panel-store-credit" class="favo-panel-section">
        <h3 class="favo-panel-title">Store Credit</h3>
        <p class="favo-panel-subtitle">Check your balance and transactions</p>
        <hr class="favo-panel-divider">
        
        <div style="margin-bottom: 24px; padding: 24px; border: 1px solid #e5e5e5; display: inline-block;">
          <span style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: #707070; display: block; margin-bottom: 6px;">Store Credit Balance</span>
          <span style="font-size: 24px; font-weight: 500;">$0.00</span>
        </div>
        
        <div class="favo-empty-state">
          <p>No transactions yet</p>
        </div>
      </section>

      <!-- Panel: Payment Methods -->
      <section id="panel-payment-methods" class="favo-panel-section">
        <h3 class="favo-panel-title">Payment Methods</h3>
        <p class="favo-panel-subtitle">Manage your saved cards</p>
        <hr class="favo-panel-divider">
        
        <div class="favo-panel-box">
          <div class="favo-panel-box-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 256 256">
              <path d="M224,48H32A16,16,0,0,0,16,64V192a16,16,0,0,0,16,16H224a16,16,0,0,0,16-16V64A16,16,0,0,0,224,48Zm0,48H32V64H224V96Zm0,96H32V112H224v80Z"></path>
            </svg>
          </div>
          <div class="favo-panel-box-body">
            <h4>Payment methods</h4>
            <p>Add or manage your payment methods.</p>
            
            <a href="https://account.flupi.store/profile" target="_blank" class="favo-btn-black">
              Continue
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256">
                <path d="M224,104V32H152a8,8,0,0,1,0-16h80a8,8,0,0,1,8,8v80a8,8,0,0,1-16,0ZM133.66,133.66a8,8,0,0,1-11.32-11.32l96-96a8,8,0,0,1,11.32,11.32ZM208,144v64H48V48h64a8,8,0,0,0,0-16H40A24,24,0,0,0,16,56V216a24,24,0,0,0,24,24H216a24,24,0,0,0,24-24V144a8,8,0,0,0-16,0Z"></path>
              </svg>
            </a>
            <span class="favo-panel-box-caption">Opens in a new tab.</span>
          </div>
        </div>
      </section>

      <!-- Panel: Marketing Preferences -->
      <section id="panel-marketing" class="favo-panel-section">
        <h3 class="favo-panel-title">Marketing Preferences</h3>
        <p class="favo-panel-subtitle">Tailor your emails from us</p>
        <hr class="favo-panel-divider">
        
        <div class="favo-privacy-section">
          <h4>Marketing Communications Preferences</h4>
          <p id="favo-marketing-status">You're subscribed to emails about our latest arrivals and promotions.</p>
          <button type="button" class="favo-btn-black" id="favo-marketing-toggle-btn">Unsubscribe from emails</button>
          
          <p style="margin-top: 24px; font-size: 11px; color: #707070;">
            For further information on how we process your data, please read our <a href="#" style="color: #121212; text-decoration: underline;">Privacy Policy</a>.
          </p>
        </div>
      </section>

      <!-- Panel: Privacy Settings -->
      <section id="panel-privacy" class="favo-panel-section">
        <h3 class="favo-panel-title">Privacy Settings</h3>
        <p class="favo-panel-subtitle">We use your personal data to improve the service we provide. Please be assured that we will never sell, share or misuse any information you share with us.</p>
        <hr class="favo-panel-divider">
        
        <div class="favo-privacy-section">
          <h4>Account Terms and Conditions</h4>
          <a href="#" style="display: inline-block; margin-bottom: 8px;">Read the Terms and Conditions</a>
        </div>
        
        <div class="favo-privacy-section">
          <h4>Privacy Policy</h4>
          <a href="#" style="display: inline-block; margin-bottom: 8px;">Read our Privacy Policy</a>
        </div>
        
        <div class="favo-privacy-section">
          <h4>Customer Data Requests</h4>
          <p>Depending on where you are a resident, you may have rights in relation to the information that we hold about you.</p>
          <p>Find out more in our Privacy Policy above. To exercise your rights regarding data access, change, or deletion, please contact us.</p>
          <div style="display: flex; gap: 20px;">
            <a href="mailto:privacy@flupi.store?subject=Data Access Request" style="font-weight: 500;">Access</a>
            <a href="mailto:privacy@flupi.store?subject=Data Change Request" style="font-weight: 500;">Change</a>
          </div>
        </div>

        <div class="favo-privacy-section">
          <h4>Close Account</h4>
          <p>We inform you that by proceeding with the account deletion request, we will delete your account and all related personal data as soon as possible and no later than 30 days from the date your request is received.</p>
          <p>Please make sure you have used all your store credits and remember that the deletion may require more time to be processed in case you have an active order or return. Please consider that you may still use your account and receive notifications before your account deletion request is fulfilled.</p>
          <p>For further details on how we process your personal data, take a look at our <a href="#">Privacy Policy</a>.</p>
          <a href="mailto:privacy@flupi.store?subject=Close Account Request" style="font-weight: 600;">Email our privacy team</a>
        </div>
      </section>

    </main>
  </div>

</div>

<script>
  (function() {
    document.addEventListener("DOMContentLoaded", function() {
      const portalRoot = document.getElementById("favo-account-portal");
      if (!portalRoot) return;

      const customerName = portalRoot.dataset.customerName || "Customer";
      const greetingText = document.getElementById("favo-greeting-text");
      const viewDashboard = document.getElementById("favo-view-dashboard");
      const viewSplit = document.getElementById("favo-view-split");
      const panels = viewSplit.querySelectorAll(".favo-panel-section");
      const sidebarLinks = viewSplit.querySelectorAll(".favo-sidebar-link");

      // Dynamic timezone greeting
      const hour = new Date().getHours();
      let greeting = "GOOD AFTERNOON";
      if (hour < 12) greeting = "GOOD MORNING";
      else if (hour > 17) greeting = "GOOD EVENING";
      
      if (greetingText) {
        greetingText.textContent = `${greeting} ${customerName}`;
      }

      // Router logic (URL Hash listener)
      function handleRoute() {
        const hash = window.location.hash;
        if (!hash || hash === "#" || hash === "#your-account") {
          // Show main dashboard
          viewDashboard.classList.remove("favo-filter-hidden");
          viewSplit.classList.add("favo-filter-hidden");
          
          sidebarLinks.forEach(link => link.classList.remove("active"));
          sidebarLinks[0].classList.add("active");
        } else {
          // Show split panel view
          viewDashboard.classList.add("favo-filter-hidden");
          viewSplit.classList.remove("favo-filter-hidden");
          
          // Get panel id matching target key
          const targetKey = hash.replace("#", "");
          let matched = false;

          panels.forEach(panel => {
            if (panel.id === `panel-${targetKey}`) {
              panel.classList.add("active");
              matched = true;
            } else {
              panel.classList.remove("active");
            }
          });

          // Highlight active link in sidebar
          sidebarLinks.forEach(link => {
            if (link.dataset.target === targetKey) {
              link.classList.add("active");
            } else {
              link.classList.remove("active");
            }
          });

          // If hash doesn't match any local panel, default back
          if (!matched && targetKey !== "") {
            window.location.hash = "";
          }
        }
      }

      // Listen to navigation events
      window.addEventListener("hashchange", handleRoute);
      handleRoute(); // Run initial router check on load

      // Marketing preference simulator toggle
      const marketingBtn = document.getElementById("favo-marketing-toggle-btn");
      const marketingStatus = document.getElementById("favo-marketing-status");
      
      if (marketingBtn && marketingStatus) {
        let subscribed = true;
        marketingBtn.addEventListener("click", function() {
          subscribed = !subscribed;
          if (subscribed) {
            marketingStatus.textContent = "You're subscribed to emails about our latest arrivals and promotions.";
            marketingBtn.textContent = "Unsubscribe from emails";
          } else {
            marketingStatus.textContent = "You are currently unsubscribed from marketing communications.";
            marketingBtn.textContent = "Subscribe to emails";
          }
        });
      }

    });
  })();
</script>

{% schema %}
{
  "name": "Favo Account Portal",
  "target": "section",
  "settings": []
}
{% endschema %}
